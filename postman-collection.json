{
  "info": {
    "name": "Learning Distributed Tracing - Jaeger & OpenTelemetry",
    "description": "API collection for testing distributed tracing scenarios with Jaeger",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "gateway_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "order_service_url",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "inventory_service_url",
      "value": "http://localhost:8082",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Flow 1: Create Order (Happy Path)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{gateway_url}}/api/orders",
          "host": ["{{gateway_url}}"],
          "path": ["api", "orders"]
        },
        "description": "Creates an order with sufficient stock. Demonstrates successful multi-service trace."
      }
    },
    {
      "name": "Flow 2: Create Order (Out of Stock)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 3,\n  \"quantity\": 100\n}"
        },
        "url": {
          "raw": "{{gateway_url}}/api/orders",
          "host": ["{{gateway_url}}"],
          "path": ["api", "orders"]
        },
        "description": "Attempts to create an order with insufficient stock. Demonstrates error propagation across services."
      }
    },
    {
      "name": "Flow 3: Get Order Details",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gateway_url}}/api/orders/1",
          "host": ["{{gateway_url}}"],
          "path": ["api", "orders", "1"]
        },
        "description": "Retrieves order details by ID. Demonstrates simple database query tracing."
      }
    },
    {
      "name": "Flow 4: Get All Products (Slow Query)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gateway_url}}/api/inventory/products",
          "host": ["{{gateway_url}}"],
          "path": ["api", "inventory", "products"]
        },
        "description": "Retrieves all products with simulated 2.5s delay. Demonstrates latency bottleneck identification."
      }
    },
    {
      "name": "Flow 5: Create Bulk Orders (Custom Spans)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orders\": [\n    {\"productId\": 1, \"quantity\": 2},\n    {\"productId\": 2, \"quantity\": 1},\n    {\"productId\": 4, \"quantity\": 3}\n  ]\n}"
        },
        "url": {
          "raw": "{{gateway_url}}/api/orders/bulk",
          "host": ["{{gateway_url}}"],
          "path": ["api", "orders", "bulk"]
        },
        "description": "Creates multiple orders with custom manual spans. Demonstrates manual span creation for business logic."
      }
    },
    {
      "name": "Direct: Get Product by ID (Inventory Service)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{inventory_service_url}}/api/inventory/1?quantity=2",
          "host": ["{{inventory_service_url}}"],
          "path": ["api", "inventory", "1"],
          "query": [
            {
              "key": "quantity",
              "value": "2"
            }
          ]
        },
        "description": "Direct call to Inventory Service to check stock for a product."
      }
    },
    {
      "name": "Direct: Create Order (Order Service)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": 1,\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{order_service_url}}/api/orders",
          "host": ["{{order_service_url}}"],
          "path": ["api", "orders"]
        },
        "description": "Direct call to Order Service (bypassing API Gateway)."
      }
    },
    {
      "name": "Health Check: API Gateway",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gateway_url}}/actuator/health",
          "host": ["{{gateway_url}}"],
          "path": ["actuator", "health"]
        },
        "description": "Check health status of API Gateway"
      }
    },
    {
      "name": "Health Check: Order Service",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{order_service_url}}/actuator/health",
          "host": ["{{order_service_url}}"],
          "path": ["actuator", "health"]
        },
        "description": "Check health status of Order Service"
      }
    },
    {
      "name": "Health Check: Inventory Service",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{inventory_service_url}}/actuator/health",
          "host": ["{{inventory_service_url}}"],
          "path": ["actuator", "health"]
        },
        "description": "Check health status of Inventory Service"
      }
    }
  ]
}
